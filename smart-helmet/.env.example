# ============================================================================
# Smart Helmet for Industrial Safety - Environment Configuration
# ============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to version control.
# ============================================================================

# --- Backend Server ---
API_PORT=3001
# Bind to 0.0.0.0 so ESP8266 on the LAN can reach the server.
# Use 127.0.0.1 to restrict to localhost only (ESP8266 won't connect).
BACKEND_HOST=0.0.0.0

# --- MongoDB ---
# For local MongoDB:
# MONGODB_URI=mongodb://localhost:27017/smart_helmet
# For MongoDB Atlas (replace with your connection string):
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/smart_helmet?retryWrites=true&w=majority

# --- JWT Authentication ---
# Generate a strong random secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_64_CHAR_SECRET
JWT_EXPIRES_IN=24h

# --- Device Authentication ---
# Shared token that the ESP8266 includes in telemetry POST requests.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DEVICE_TOKEN=CHANGE_ME_TO_A_RANDOM_DEVICE_TOKEN

# --- Default Admin Account (created on first run if no users exist) ---
ADMIN_EMAIL=admin@smarthelmet.local
ADMIN_PASSWORD=CHANGE_ME_admin_password_123

# --- Alert Thresholds (defaults, overridable per device in the UI) ---
TEMPERATURE_WARNING_C=45
TEMPERATURE_CRITICAL_C=60
FLAME_ACTIVE_HIGH=true

# --- Device Connectivity ---
# Seconds without telemetry before a device is considered offline
DEVICE_OFFLINE_TIMEOUT_S=30

# --- CORS ---
# Comma-separated allowed origins for the dashboard
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Rate Limiting ---
# Max telemetry requests per device per minute
TELEMETRY_RATE_LIMIT=120
# Max API requests per IP per 15 minutes
API_RATE_LIMIT=100

# --- Demo Mode ---
# Set to true to enable simulated telemetry generation
DEMO_MODE=false
DEMO_DEVICE_ID=HELMET-DEMO-001
DEMO_INTERVAL_MS=2000

# --- Logging ---
LOG_LEVEL=info

# ============================================================================
# HARDWARE CONFIGURATION (for reference when flashing firmware)
# These are NOT read by the backend; they document what you set in the .ino
# ============================================================================
# WIFI_SSID=YourNetworkName
# WIFI_PASSWORD=YourNetworkPassword
# ESP8266_SERVER_IP=192.168.1.100  (your laptop's LAN IP)
# ESP8266_SERVER_PORT=3001
# DEVICE_ID=HELMET-001

